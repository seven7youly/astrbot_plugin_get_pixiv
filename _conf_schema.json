{
  "config_ui_note": {
    "description": "配置说明",
    "type": "text",
    "default": "以下配置请在插件 WebUI「星绘漫游设置」中更改（插件页包含内容安全、插件配置、大语言模型三个标签）。此处仅作查看，修改请以插件 UI 为准。",
    "readonly": true,
    "obvious_hint": true,
    "hint": "请在插件 UI 界面更改配置。"
  },
  "pixiv_refresh_token": {
    "description": "Pixiv refresh_token",
    "type": "string",
    "default": "",
    "hint": "可选。Lolicon 主源失败时用于 Pixiv 搜索或推荐作品回退；留空不影响 Lolicon 发图。"
  },
  "lolicon_api_url": {
    "description": "Lolicon API 地址",
    "type": "string",
    "default": "https://api.lolicon.app/setu/v2",
    "hint": "首选图片源地址。留空会停用 Lolicon，仅在配置 refresh_token 时使用 Pixiv 回退。"
  },
  "lolicon_exclude_ai": {
    "description": "Lolicon 排除 AI 作品",
    "type": "bool",
    "default": true,
    "hint": "开启后向 Lolicon API 传递 excludeAI=true。"
  },
  "allow_r18": {
    "description": "允许 R18 内容",
    "type": "bool",
    "default": false,
    "hint": "默认关闭，仅发送全年龄（普通分级）作品；开启后允许发送 R18 作品。"
  },
  "lolicon_image_proxy_origins": {
    "description": "Lolicon 图片反代地址",
    "type": "text",
    "default": "",
    "obvious_hint": true,
    "hint": "可选，每行填写一个完整的 http(s) origin，最多使用 5 个并按顺序尝试；拒绝账号密码、路径、query 和 fragment，重复项自动删除。仅改写 Lolicon 来源且位于允许列表中的 Pixiv 图片主机，不代理 API、Pixiv 登录或其他网络请求。全部失败后回退 Lolicon 返回地址；留空表示不改写，保存并重载插件后生效。"
  },
  "filter_manga": {
    "description": "过滤漫画",
    "type": "bool",
    "default": true,
    "hint": "开启后过滤 Pixiv 回退结果中的 manga；Lolicon 返回项按插画处理。"
  },
  "max_count": {
    "description": "单次最大发送数量",
    "type": "int",
    "default": 5,
    "slider": {
      "min": 1,
      "max": 20,
      "step": 1
    },
    "hint": "用户单次指令最多发送几张图。"
  },
  "dedupe_days": {
    "description": "图片去重天数",
    "type": "int",
    "default": 1,
    "slider": {
      "min": 0,
      "max": 7,
      "step": 1
    },
    "hint": "按北京时间自然日去重。0=关闭并清空去重记录，1=仅当天，2-7=最近对应天数。同群成员共享；不同群、私聊用户、标签和图片源相互隔离。缩短天数会在插件重载时清理超期记录，增加天数无法恢复已清理历史。"
  },
  "dedupe_ttl_hours": {
    "description": "旧版去重配置（迁移用）",
    "type": "float",
    "default": 24.0,
    "invisible": true
  },
  "dedupe_days_migrated": {
    "description": "去重配置迁移标记",
    "type": "bool",
    "default": false,
    "invisible": true
  },
  "request_timeout": {
    "description": "下载超时（秒）",
    "type": "float",
    "default": 30.0,
    "slider": {
      "min": 5,
      "max": 120,
      "step": 5
    },
    "hint": "单张图片下载的最大等待时间。"
  },
  "image_quality": {
    "description": "图片质量",
    "type": "string",
    "default": "large",
    "options": [
      "original",
      "large",
      "medium"
    ],
    "hint": "large=大图（默认推荐）, original=原图（最大，下载慢）, medium=中图（最小，下载快）。若原图超过自动降级阈值会降级到更低质量，指定质量不可用也会自动降级。"
  },
  "auto_downgrade_original_mb": {
    "description": "原图自动降级阈值（MiB）",
    "type": "float",
    "default": 3.0,
    "slider": {
      "min": 0,
      "max": 100,
      "step": 0.5
    },
    "hint": "当实际下载到的原图超过该大小时，自动改用 large/medium 等低质量图片。设为 0 可禁用自动降级。"
  },
  "forward_threshold": {
    "description": "合并转发阈值",
    "type": "int",
    "default": 1,
    "slider": {
      "min": 0,
      "max": 20,
      "step": 1
    },
    "hint": "成功下载的图片数量严格大于此值时以合并转发发送。设为 0 时始终合并转发；设为 1 时超过 1 张才合并转发。仅 aiocqhttp 平台支持合并转发，其他平台会自动逐条发送。"
  },
  "auto_trigger_enabled": {
    "description": "自然语言自动触发",
    "type": "bool",
    "default": true,
    "hint": "默认开启。开启后，群内发送包含「来份/张图」等自然语言时自动触发发图，无需命令前缀；关闭后仅可通过 /pv 指令发图，LLM 工具调用也会被拒绝。"
  },
  "rate_limit_seconds": {
    "description": "请求频率限制（秒）",
    "type": "int",
    "default": 3,
    "slider": {
      "min": 0,
      "max": 60,
      "step": 1
    },
    "hint": "同一用户两次请求的最小间隔，设为 0 禁用。防止刷屏。"
  },
  "record_message_to_conversation": {
    "description": "记录发送结果到对话",
    "type": "bool",
    "default": true,
    "hint": "开启后，插件发图成功会把本次请求与发送结果写入 AstrBot 对话历史，让大模型/AI 在后续对话中看到插件发送的消息。仅对存在对话记录（如 AI 会话）时生效；LLM 工具调用由框架自动记录，不重复写入。"
  },
  "llm_describe_images": {
    "description": "发送后让大模型查看图片",
    "type": "bool",
    "default": false,
    "hint": "开启后，插件发图成功会调用当前会话的聊天大模型（需支持图片输入/多模态）查看已发送的图片并生成内容描述。描述不会发送到聊天框，只会写入对话历史，让机器人对图片内容形成持久记忆，同时保持聊天平台的连续性。直接复用发图用到的临时文件，不额外占用磁盘；失败时静默跳过，不影响发图。"
  },
  "llm_describe_prompt": {
    "description": "图片描述提示词",
    "type": "text",
    "default": "请简要描述这张图片的内容、构图与氛围，用中文，不超过 80 字。",
    "obvious_hint": true,
    "hint": "llm_describe_images 开启时，发送给多模态大模型的查看图片基础提示词。当发图带搜索标签时，会自动在该提示词后追加「图片由标签搜索获得，请结合标签客观描述并判断是否相符」的说明，让描述绑定标签、更客观。"
  },
  "llm_search_tag_retries": {
    "description": "自然语言无结果时更换标签次数",
    "type": "int",
    "default": 2,
    "slider": {
      "min": 0,
      "max": 5,
      "step": 1
    },
    "hint": "使用自然语言调用发图时，若标签无结果，会调用大模型更换/优化标签（如翻译为日语）重新搜索，最多重试该次数（0-5）。全部失败后才提示无结果。"
  },
  "llm_natural_replies": {
    "description": "用大模型人格改写回复",
    "type": "bool",
    "default": true,
    "hint": "开启后，插件的功能提示会调用当前会话大模型按人格设定改写为自然口语；无法调用大模型或关闭时使用默认回复文案。"
  },
